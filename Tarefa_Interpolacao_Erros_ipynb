        "        xe = np.linspace(x_min, x_max, N); xc = nos_chebyshev_lobatto(x_min, x_max, N)\n",
        "        acum = {\"Lagrange equi\":[], \"Lagrange Cheb\":[], \"Spline cúbica natural\":[], \"Spline suavização (GCV)\":[]}\n",
        "        for _ in range(n_mc):\n",
        "            ye = temperatura_real(xe) + rng.normal(0, sg, N)\n",
        "            yc = temperatura_real(xc) + rng.normal(0, sg, N)\n",
        "            preds = {\"Lagrange equi\": BarycentricInterpolator(xe, ye)(x_fino),\n",
        "                     \"Lagrange Cheb\": BarycentricInterpolator(xc, yc)(x_fino),\n",
        "                     \"Spline cúbica natural\": CubicSpline(xe, ye, bc_type=\"natural\")(x_fino)}\n",
        "            if N >= 5:\n",
        "                preds[\"Spline suavização (GCV)\"] = smoothing_spline(xe, ye, sg)(x_fino)\n",
        "            for k, v in preds.items():\n",
        "                acum[k].append(v - T_fino)\n",
        "        for k, lst in acum.items():\n",
