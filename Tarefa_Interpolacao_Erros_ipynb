      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import time\n",
        "from scipy.interpolate import BarycentricInterpolator, interp1d, CubicSpline\n",
        "np.set_printoptions(precision=4, suppress=True)\n",
        "pd.set_option(\"display.float_format\", lambda v: f\"{v:.3e}\")\n",
        "plt.rcParams[\"figure.figsize\"] = (9, 5)\n",
        "plt.rcParams[\"axes.grid\"] = True\n",
        "plt.rcParams[\"grid.alpha\"] = 0.25\n",
        "\n",
        "L = 6.0\n",
        "def temperatura_real(x):\n",
        "    \"\"\"Perfil analítico de referência em °C; x em metros.\"\"\"\n",
        "    x = np.asarray(x, dtype=float)\n",
        "    xi = x/L\n",
        "    return 18 + 2.4*xi + 2.5*np.sin(np.pi*xi)\n",
        "\n",
        "x_min, x_max = 0.0, L\n",
        "x_fino = np.linspace(x_min, x_max, 2001)\n",
        "T_fino = temperatura_real(x_fino)\n",
        "print(f\"T(0) = {temperatura_real(0):.1f} °C | T(L) = {temperatura_real(L):.1f} °C\")"
      ]
    },
