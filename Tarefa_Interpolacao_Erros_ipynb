        "# Interpolação x extrapolação. Sensores em [0, 6] m; avaliação também fora (zonas cinza).\n",
        "rng = np.random.default_rng(7)\n",
        "x_ext = np.linspace(-2, 8, 1001)\n",
        "\n",
        "def cenario(N, sg):\n",
        "    xs = np.linspace(0, 6, N)\n",
        "    ys = temperatura_real(xs) + rng.normal(0, sg, N)\n",
        "    return {\"Lagrange equi\": BarycentricInterpolator(xs, ys),\n",
        "            \"Spline cúbica natural\": CubicSpline(xs, ys, bc_type=\"natural\", extrapolate=True)}\n",
        "\n",
        "fig, ax = plt.subplots(1, 2, figsize=(14, 5))\n",
        "for a, (N, sg) in zip(ax, [(7, 0.0), (13, 0.2)]):\n",
        "    m = cenario(N, sg)\n",
        "    a.plot(x_ext, temperatura_real(x_ext), \"k-\", lw=3, alpha=0.35, label=\"fórmula idealizada\")\n",
        "    a.plot(x_ext, m[\"Lagrange equi\"](x_ext), color=\"#d62728\", label=\"Lagrange equi\")\n",
        "    a.plot(x_ext, m[\"Spline cúbica natural\"](x_ext), color=\"#1f77b4\", label=\"Spline cúbica natural\")\n",
        "    a.axvspan(-2, 0, color=\"gray\", alpha=0.15); a.axvspan(6, 8, color=\"gray\", alpha=0.15)\n",
        "    a.set_ylim(10, 28); a.set_xlabel(\"x (m)\"); a.set_ylabel(\"T (°C)\")\n",
        "    a.set_title(f\"N={N}, σ={sg} °C (cinza = extrapolação)\"); a.legend(fontsize=8)\n",
        "plt.tight_layout(); plt.show()\n",
        "\n",
        "# Tabela: erro em função da distância fora do intervalo (média de 200 realizações, N=13, σ=0.2)\n",
        "pontos = [-2, -1, -0.5, 0, 3, 6, 6.5, 7, 8]\n",
        "acc = {\"Lagrange equi\": [], \"Spline cúbica natural\": []}\n",
        "for _ in range(200):\n",
