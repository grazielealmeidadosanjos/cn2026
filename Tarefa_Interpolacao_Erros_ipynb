      "source": [
        "# Verificação do perfil: T'' = -2.5*pi^2/L^2 * sin(pi x/L)  (diferenças finitas centrais)\n",
        "h = 1e-3\n",
        "xc = np.linspace(0.5, 5.5, 6)\n",
        "d2_num = (temperatura_real(xc+h) - 2*temperatura_real(xc) + temperatura_real(xc-h))/h**2\n",
        "d2_ana = -2.5*np.pi**2/L**2*np.sin(np.pi*xc/L)\n",
        "print(pd.DataFrame({\"x (m)\": xc, \"T'' numérica\": d2_num, \"T'' analítica\": d2_ana}).to_string(index=False, float_format=lambda v: f\"{v:.5f}\"))\n",
        "print(\"\\nEm x=0 e x=L: T''=0 (sin(0)=sin(pi)=0) -> a condição 'natural' da spline cúbica é EXATA para este perfil.\")"
      ]
