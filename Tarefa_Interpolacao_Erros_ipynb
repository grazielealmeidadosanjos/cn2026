        "    \"\"\"Spline de suavização (regressão): lam escolhido por validação cruzada generalizada (GCV).\"\"\"\n",
        "    from scipy.interpolate import make_smoothing_spline\n",
        "    return make_smoothing_spline(x, y)      # lam=None -> GCV\n",
        "\n",
