      "source": [
        "def tempo_medio(f, rep=20):\n",
        "    t0 = time.perf_counter()\n",
        "    for _ in range(rep): f()\n",
        "    return (time.perf_counter()-t0)/rep\n",
        "\n",
        "Ns = np.arange(4, 41)\n",
        "reg = []\n",
        "for N in Ns:\n",
        "    xe = np.linspace(x_min, x_max, N); xc = nos_chebyshev_lobatto(x_min, x_max, N)\n",
        "    for nome, nos, ctor in [\n",
        "        (\"Lagrange equiespaçado\", xe, lambda x, y: BarycentricInterpolator(x, y)),\n",
        "        (\"Lagrange Chebyshev\",   xc, lambda x, y: BarycentricInterpolator(x, y)),\n",
        "        (\"Spline cúbica natural\", xe, lambda x, y: CubicSpline(x, y, bc_type=\"natural\"))]:\n",
        "        y = temperatura_real(nos)\n",
        "        t_cons = tempo_medio(lambda: ctor(nos, y))\n",
        "        p = ctor(nos, y)\n",
        "        t_aval = tempo_medio(lambda: p(x_fino))\n",
        "        e = p(x_fino) - T_fino\n",
        "        reg.append({\"N\": N, \"Método\": nome,\n",
        "                    \"Emax\": np.max(np.abs(e)), \"RMSE\": np.sqrt(np.mean(e**2)),\n",
        "                    \"t_construção (s)\": t_cons, \"t_avaliação (s)\": t_aval})\n",
        "est = pd.DataFrame(reg)\n",
        "display(est[est[\"N\"].isin([4, 8, 12, 16, 20, 30, 40])])"
      ]
    },
