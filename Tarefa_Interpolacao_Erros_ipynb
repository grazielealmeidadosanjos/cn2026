        "# Estabilidade numérica: Lagrange pela base monomial (Vandermonde) vs. forma baricêntrica\n",
        "rows = []\n",
        "for N in [5, 9, 13, 17, 21, 25, 30]:\n",
        "    for rot, nos in [(\"Equi\", np.linspace(x_min, x_max, N)), (\"Cheb\", nos_chebyshev_lobatto(x_min, x_max, N))]:\n",
        "        y = temperatura_real(nos)\n",
        "        V = np.vander(nos, increasing=True)\n",
        "        cond = np.linalg.cond(V)\n",
        "        coef = np.linalg.solve(V, y)\n",
        "        e_mon = np.max(np.abs(np.polynomial.polynomial.polyval(x_fino, coef) - T_fino))\n",
        "        e_bar = np.max(np.abs(BarycentricInterpolator(nos, y)(x_fino) - T_fino))\n",
        "        rows.append({\"N\": N, \"Nós\": rot, \"cond(Vandermonde)\": cond, \"Emax monomial\": e_mon, \"Emax baricêntrica\": e_bar})\n",
        "display(pd.DataFrame(rows))"
